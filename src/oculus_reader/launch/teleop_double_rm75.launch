<launch>
  <!-- rm_driver uses absolute /rm_driver topics in the official package and
       therefore cannot be safely duplicated in one ROS master. SDK mode is
       the default for two arms; set start_drivers:=false when using it. -->
  <arg name="start_drivers" default="false" />
  <arg name="robot_backend" default="rm_sdk" />
  <arg name="left_rm_ip" default="192.168.1.18" />
  <arg name="right_rm_ip" default="192.168.1.19" />
  <arg name="rm_port" default="8080" />
  <arg name="show_rviz" default="true" />

  <group ns="left" if="$(arg start_drivers)">
    <include file="$(find rm_driver)/launch/rm_75_driver.launch">
      <arg name="Arm_IP" value="$(arg left_rm_ip)" />
      <arg name="Arm_Port" value="$(arg rm_port)" />
      <arg name="Arm_Dof" value="7" />
      <arg name="Arm_Type" value="RM75" />
    </include>
  </group>
  <group ns="right" if="$(arg start_drivers)">
    <include file="$(find rm_driver)/launch/rm_75_driver.launch">
      <arg name="Arm_IP" value="$(arg right_rm_ip)" />
      <arg name="Arm_Port" value="$(arg rm_port)" />
      <arg name="Arm_Dof" value="7" />
      <arg name="Arm_Type" value="RM75" />
    </include>
  </group>

  <node name="teleop_double_rm75_node" pkg="oculus_reader"
        type="teleop_double_piper.py" output="screen">
    <rosparam command="load" file="$(find oculus_reader)/config/rm75.yaml" />
    <param name="robot_backend" value="$(arg robot_backend)" />
    <param name="left_rm_ip" value="$(arg left_rm_ip)" />
    <param name="right_rm_ip" value="$(arg right_rm_ip)" />
    <param name="left_joint_command_topic" value="/left/rm_driver/JointPos" />
    <param name="right_joint_command_topic" value="/right/rm_driver/JointPos" />
    <param name="left_gripper_command_topic" value="/left/rm_driver/Gripper_Set" />
    <param name="right_gripper_command_topic" value="/right/rm_driver/Gripper_Set" />
    <param name="left_state_topic" value="/left/joint_states" />
    <param name="right_state_topic" value="/right/joint_states" />
  </node>

  <node name="pub_pose_node" pkg="oculus_reader" type="pub_pose.py" output="screen" />
  <node if="$(arg show_rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find oculus_reader)/config/oculus_reader.rviz" />
</launch>
